; dm2000_keys.ini - Action mappings for reaper_csurf_dm2000
;
; The build/install step copies this file to REAPER's resource folder as
; dm2000_keys.ini if it does not already exist. Edit that copy to customise;
; do not edit this file directly (it will be overwritten on reinstall).
;
; Values are REAPER action IDs. To find an ID:
;   Actions > Show action list, search by name, right-click > "Copy selected
;   action command ID". For SWS/ReaScript actions install the SWS extension.
;   See also: doc/dm2000_keys_guide.md in the plugin repository.
;
; A value of 0 means "no action" (button is silently ignored).
; Omitting a key keeps the compiled-in default for that button.


; ===========================================================================
; [locate] - Locate Memory section buttons
;
; The DM2000 Locate Memory section has two rows of buttons above the transport:
;
;   Row 1 (zone 0x10, hw-verified 2026-06-15):
;     AUDITION  PRE  IN  OUT  POST
;
;   Row 2 (zone 0x0F, hw-verified 2026-06-15):
;     RTZ  END  ONLINE  LOOP  QUICK PUNCH
;     (SET / REHEARSAL / MTR / MASTER do not transmit HUI - DM2000 internal only)
;
;   Locate Memory buttons LM1-LM8 (zones 0x13 / 0x15, hw-verified 2026-06-15)
;
; Default assignments below match native REAPER workflow.
; Pro Tools users: see the "Pro Tools" comments for alternatives.
; More options: doc/dm2000_keys_guide.md
; ===========================================================================

[locate]

; --- Row 2 (zone 0x0F) ---

; RETURN TO ZERO - move playhead to project start.
; 0 = built-in CSurf_GoStart() API (recommended)
; Alternative: 40042  (Transport: Go to start of project)
rtz = 0

; END - move playhead to project end.
; 0 = built-in CSurf_GoEnd() API (recommended)
; Alternative: 40043  (Transport: Go to end of project)
end = 0

; ONLINE - no standard REAPER equivalent; repurpose freely.
; Pro Tools: toggles online/offline mode (not meaningful in REAPER).
; Suggestions:
;   40022  File: Save project
;   40043  Transport: Go to end of project
;   0      disabled (default)
online = 0

; LOOP - toggle loop/repeat mode.
; 1068   IDC_REPEAT - same as clicking the Repeat button (default)
; Pro Tools: also toggles loop playback - no change needed.
; Alternative:
;   40364  Transport: Toggle loop points with time selection
loop = 1068

; QUICK PUNCH - insert a marker at the edit cursor.
; 40157  Insert marker at current position (default)
; Pro Tools: enables/disables quick punch recording mode.
; Alternatives:
;   40172  Transport: Toggle auto-punch record mode  (Pro Tools-style)
;   40182  Track: Toggle record arm for selected tracks
;   40157  Insert marker at edit cursor (default)
qpunch = 40157


; --- Row 1 (zone 0x10) ---

; AUDITION - no HUI standard action; repurpose freely.
; Pro Tools: auditions the selection with pre-roll.
; Suggestions:
;   40044  Transport: Play/stop
;   40046  Transport: Play (with pre-roll)
;   0      disabled (default)
audition = 0

; PRE - no HUI standard action; repurpose freely.
; Pro Tools: sets/adjusts pre-roll.
; Suggestions:
;   40022  File: Save project
;   40157  Insert marker at edit cursor
;   0      disabled (default)
pre = 0

; IN - set loop in-point to the current edit cursor position.
; 40222  Transport: Set loop start point (default)
; Pro Tools: also sets the loop/punch in-point - no change needed.
; Alternative:
;   40631  Transport: Set loop start point at edit cursor
in = 40222

; OUT - set loop out-point to the current edit cursor position.
; 40223  Transport: Set loop end point (default)
; Pro Tools: also sets the loop/punch out-point - no change needed.
; Alternative:
;   40632  Transport: Set loop end point at edit cursor
out = 40223

; POST - insert a region from the current time selection.
; 40174  Insert region from time selection (default)
; Pro Tools: sets/adjusts post-roll.
; Alternatives:
;   40171  Insert time signature marker at current position
;   0      disabled
post = 40174


; --- Locate Memory buttons LM1-LM8 ---
;
; Default: jump to REAPER markers 1-8 (action IDs 40161-40168).
; Pro Tools: stores/recalls locate points numbered 1-8 - same idea.
;
; To set (write) a marker from the console: remap an LM button to the
; corresponding "Go to and set marker N" action (find it in the action list).
; Or keep LM for recall and use a UDK button for set.
;
; To jump to a marker: 40161 = marker 1, +1 for each (40168 = marker 8).

lm1 = 40161   ; Go to marker 1
lm2 = 40162   ; Go to marker 2
lm3 = 40163   ; Go to marker 3
lm4 = 40164   ; Go to marker 4
lm5 = 40165   ; Go to marker 5
lm6 = 40166   ; Go to marker 6
lm7 = 40167   ; Go to marker 7
lm8 = 40168   ; Go to marker 8


; ===========================================================================
; [udk] - User Defined Keys (UDK 1-16)
;
; NOTE: the UDK dispatcher is not yet implemented in the plugin.
;       Entries below are placeholders for a future release.
;
; Zone/switch reference for confirmed UDK button MIDI positions:
;   UDK  4: zone 0x08 sw1      UDK 13: zone 0x08 sw3
;   UDK  5: zone 0x08 sw5      UDK 14: zone 0x08 sw7
;   UDK  6: zone 0x19 sw3
;   UDK  7: zone 0x19 sw4
;   UDK  8: zone 0x19 sw5
;   UDK 1/2/3/9/10/11/12/15/16: zone/sw unconfirmed (capture with MIDI-OX)
;
; Per manual ch.19 and hardware verification:
;   UDK  2 = BANK <  (zone 0x0A sw1) - already handled by the csurf
;   UDK  3 = BANK >  (zone 0x0A sw3) - already handled by the csurf
;   UDK 10 = CH <    (zone 0x0A sw0) - already handled by the csurf
;   UDK 11 = CH >    (zone 0x0A sw2) - already handled by the csurf
;
; Full protocol reference: DESIGN.md "Zone assignments" section.
; ===========================================================================

[udk]

; Suggestions (uncomment and adjust as needed):

; key4  = 40029   ; Undo
; key5  = 40030   ; Redo
; key6  = 40022   ; Save project
; key7  = 40157   ; Insert marker at edit cursor
; key8  = 0
; key13 = 0
; key14 = 0
