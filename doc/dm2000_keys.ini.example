; dm2000_keys.ini - Action mappings for reaper_csurf_dm2000
;
; The build/install step copies this file to REAPER's resource folder as
; dm2000_keys.ini if it does not already exist. Edit that copy to customise;
; do not edit this file directly (it will be overwritten on reinstall).
;
; Values are REAPER action IDs. To find an ID:
;   Actions > Show action list, search by name, right-click > "Copy selected
;   action command ID". For SWS/ReaScript actions install the SWS extension.
;   See also: doc/dm2000_keys_guide.md in the plugin repository.
;
; A value of 0 means "no action" (button is silently ignored).
; Omitting a key keeps the compiled-in default for that button.


; ===========================================================================
; [locate] - Locate Memory section buttons
;
; The DM2000 Locate Memory section has two rows of buttons above the transport:
;
;   Row 1 (zone 0x10, hw-verified 2026-06-15):
;     AUDITION  PRE  IN  OUT  POST
;
;   Row 2 (zone 0x0F, hw-verified 2026-06-15):
;     RTZ  END  ONLINE  LOOP  QUICK PUNCH
;     (SET / REHEARSAL / MTR / MASTER do not transmit HUI - DM2000 internal only)
;
;   Locate Memory buttons LM1-LM8 (zones 0x13 / 0x15, hw-verified 2026-06-15)
;
; Default assignments below match native REAPER workflow.
; Pro Tools users: see the "Pro Tools" comments for alternatives.
; More options: doc/dm2000_keys_guide.md
; ===========================================================================

[locate]

; --- Row 2 (zone 0x0F) ---

; RETURN TO ZERO - move playhead to project start.
; 0 = built-in CSurf_GoStart() API (recommended)
; Alternative: 40042  (Transport: Go to start of project)
rtz = 0

; END - move playhead to project end.
; 0 = built-in CSurf_GoEnd() API (recommended)
; Alternative: 40043  (Transport: Go to end of project)
end = 0

; ONLINE - no standard REAPER equivalent; repurpose freely.
; Pro Tools: toggles online/offline mode (not meaningful in REAPER).
; Suggestions:
;   40022  File: Save project
;   40043  Transport: Go to end of project
;   0      disabled (default)
online = 0

; LOOP - toggle loop/repeat mode.
; 1068   IDC_REPEAT - same as clicking the Repeat button (default)
; Pro Tools: also toggles loop playback - no change needed.
; Alternative:
;   40364  Transport: Toggle loop points with time selection
loop = 1068

; QUICK PUNCH - insert a marker at the edit cursor.
; 40157  Insert marker at current position (default)
; Pro Tools: enables/disables quick punch recording mode.
; Alternatives:
;   40172  Transport: Toggle auto-punch record mode  (Pro Tools-style)
;   40182  Track: Toggle record arm for selected tracks
;   40157  Insert marker at edit cursor (default)
qpunch = 40157


; --- Row 1 (zone 0x10) ---

; AUDITION - no HUI standard action; repurpose freely.
; Pro Tools: auditions the selection with pre-roll.
; Suggestions:
;   40044  Transport: Play/stop
;   40046  Transport: Play (with pre-roll)
;   0      disabled (default)
audition = 0

; PRE - no HUI standard action; repurpose freely.
; Pro Tools: sets/adjusts pre-roll.
; Suggestions:
;   40022  File: Save project
;   40157  Insert marker at edit cursor
;   0      disabled (default)
pre = 0

; IN - set loop in-point to the current edit cursor position.
; 40222  Transport: Set loop start point (default)
; Pro Tools: also sets the loop/punch in-point - no change needed.
; Alternative:
;   40631  Transport: Set loop start point at edit cursor
in = 40222

; OUT - set loop out-point to the current edit cursor position.
; 40223  Transport: Set loop end point (default)
; Pro Tools: also sets the loop/punch out-point - no change needed.
; Alternative:
;   40632  Transport: Set loop end point at edit cursor
out = 40223

; POST - insert a region from the current time selection.
; 40174  Insert region from time selection (default)
; Pro Tools: sets/adjusts post-roll.
; Alternatives:
;   40171  Insert time signature marker at current position
;   0      disabled
post = 40174


; --- Locate Memory buttons LM1-LM8 ---
;
; Default: jump to REAPER markers 1-8 (action IDs 40161-40168).
; Pro Tools: stores/recalls locate points numbered 1-8 - same idea.
;
; To set (write) a marker from the console: remap an LM button to the
; corresponding "Go to and set marker N" action (find it in the action list).
; Or keep LM for recall and use a UDK button for set.
;
; To jump to a marker: 40161 = marker 1, +1 for each (40168 = marker 8).

lm1 = 40161   ; Go to marker 1
lm2 = 40162   ; Go to marker 2
lm3 = 40163   ; Go to marker 3
lm4 = 40164   ; Go to marker 4
lm5 = 40165   ; Go to marker 5
lm6 = 40166   ; Go to marker 6
lm7 = 40167   ; Go to marker 7
lm8 = 40168   ; Go to marker 8


; ===========================================================================
; [udk] - User Defined Keys (UDK 1-16)
;
; The UDK dispatcher IS implemented. On press, the key's action ID is sent via
; Main_OnCommand. key1..key16 = UDK 1..16. 0 / omitted = no action.
;
; Zone/switch map (hardware-verified 2026-06-16, full in-order capture; all 16 dispatchable):
;   UDK  1: zone 0x09 sw2      UDK  9: zone 0x09 sw0
;   UDK  2: zone 0x0A sw1      UDK 10: zone 0x0A sw0      (BANK ◄ / CH ◄)
;   UDK  3: zone 0x0A sw3      UDK 11: zone 0x0A sw2      (BANK ► / CH ►)
;   UDK  4: zone 0x08 sw1      UDK 12: zone 0x08 sw0
;   UDK  5: zone 0x08 sw5      UDK 13: zone 0x08 sw4
;   UDK  6: zone 0x19 sw5      UDK 14: zone 0x19 sw1
;   UDK  7: zone 0x19 sw3      UDK 15: zone 0x08 sw3
;   UDK  8: zone 0x19 sw4      UDK 16: zone 0x08 sw7
;
; NAVIGATION FALLBACK: UDK 2/3/10/11 are the BANK ◄/► and CH ◄/► buttons. They
; keep their built-in bank/channel navigation UNLESS you set key2/key3/key10/key11
; here - then your action overrides navigation on that button.
;
; Full protocol reference: DESIGN.md "Zone assignments" section.
; ===========================================================================

[udk]

; All 16 keys are listed below with a proposed action, COMMENTED OUT (a leading
; ';' = inactive). Uncomment a line and/or change the ID to assign that key; a
; value of 0 (or a line left commented) leaves the key with no action. key2/3/10/11
; default to BANK/CH navigation when left unset - only an uncommented non-zero value
; overrides that. Action IDs below are stock REAPER and stable across versions.

; key1  = 40029   ; UDK 1  -> Edit: Undo
; key2  = 0       ; UDK 2  -> BANK <  (set non-zero to override navigation)
; key3  = 0       ; UDK 3  -> BANK >  (set non-zero to override navigation)
; key4  = 40030   ; UDK 4  -> Edit: Redo
; key5  = 40026   ; UDK 5  -> File: Save project
; key6  = 40157   ; UDK 6  -> Markers: Insert marker at current position
; key7  = 40173   ; UDK 7  -> Markers: Go to next marker/region
; key8  = 40364   ; UDK 8  -> Options: Toggle metronome   (NOT 1013 - that is Record)
; key9  = 40172   ; UDK 9  -> Markers: Go to previous marker/region
; key10 = 0       ; UDK 10 -> CH <   (set non-zero to override navigation)
; key11 = 0       ; UDK 11 -> CH >   (set non-zero to override navigation)
; key12 = 40174   ; UDK 12 -> Markers: Insert region from time selection
; key13 = 40340   ; UDK 13 -> Track: Unsolo all tracks
; key14 = 40339   ; UDK 14 -> Track: Unmute all tracks
; key15 = 40015   ; UDK 15 -> View: Zoom out project
; key16 = 40016   ; UDK 16 -> View: Zoom in project
;          (UDK 16 with NO mapping dumps the selected track's active-FX params to
;           the REAPER console - handy for finding [surround] param indices)


; ===========================================================================
; [counter] - LED timecode display
;
; refresh_ms = how often the 8-digit LED counter is repainted (20..1000 ms).
; Default 33 (~30 Hz) gives smooth SMPTE frame counting; only digits that change
; are actually transmitted, so a fast refresh adds little MIDI traffic. Raise it
; (e.g. 100) to reduce traffic if you only display minutes:seconds.
; ===========================================================================

[counter]

; refresh_ms = 33


; ===========================================================================
; [surround] - MCS PANNER (port 4) surround pan control
;
; In Pro Tools mode the DM2000 DYNAMICS knobs and the surround joystick send
; MCS PANNER messages on USB port 4. The plugin maps them to parameters of a
; surround plugin on the SELECTED track (it never auto-inserts one).
;
; The compiled-in default is "none" - without this section the surround controls
; do nothing. The settings below are the working example (input 1 of ReaSurroundPan).
; The five DYNAMICS knobs are neighbours and control, in order: X, Y, Z, spread, gain.
; The joystick does 2D X/Y panning (it shares the X and Y params with knobs 1 & 2);
; it cannot reach Z - use knob 3 for that.
;
;   plugin       = FX name to look for (TrackFX_GetByName match)
;   param_x      = knob 1 + joystick horizontal  -> X (left/right)
;   param_y      = knob 2 + joystick vertical    -> Y (front/back)
;   param_z      = knob 3                         -> Z (height)
;   param_spread = knob 4                         -> spread / divergence
;   param_gain   = knob 5                         -> gain
;
; Param values are the plugin's parameter indices. The defaults below target
; INPUT 1 of a stock ReaSurroundPan; change them to taste:
;   6=in 1 gain  7=in 1 X(L/R)  8=in 1 Y(F/B)  9=in 1 Z(height)  10=in 1 LFE
;   11=in 1 divergence   (15+ = input 2, etc.)
;
; Different plugin or layout? Select a track that has it and press UDK 16 with
; no key16 mapping - the plugin dumps every parameter index and name to the
; REAPER console (View > Console). Copy the indices you want here.
; ===========================================================================

[surround]

plugin       = ReaSurroundPan
param_x      = 7
param_y      = 8
param_z      = 9
param_spread = 11
param_gain   = 6

; --- object/input switching (ROUTING buttons + Direct) ---
; The param_* above are OBJECT 1. The ROUTING buttons 1-8 select object 1-8 within
; the current bank; each one adds (object-1) * stride to every param_* index.
; The Direct button shifts the bank of 8: single press = up (objects 9-16, 17-24...),
; double press = down. stride = the panner's params-per-object (9 for ReaSurroundPan:
; gain/X/Y/Z/LFE/divergence/delay/mute/solo). objects = top clamp on the object count:
; 0 = auto-detect from the plugin's "in N" inputs (recommended - adapts as you add objects);
; a non-zero value forces a fixed count (for panners that don't name inputs "in N").
stride      = 9
objects     = 0


; ===========================================================================
; [debug] - diagnostics
;
; console = 1 logs surround/FX parameter and object changes to the REAPER
; console (View > Console) - useful for mapping a panner's params. Off by
; default; the UDK-16 FX param dump always prints regardless.
; ===========================================================================

[debug]

console = 0


; ===========================================================================
; [select] - channel SELECT button behaviour
;
; exclusive = 1 (default): a single SEL selects ONLY that track (Pro Tools-style);
;             hold one SEL and press others to select several at once.
; exclusive = 0: REAPER's additive toggle - each SEL press adds/removes that track.
; ===========================================================================

[select]

exclusive = 1


; ===========================================================================
; [display] - per-channel status icons and momentary scribble "peeks"
;
; insert_icon    = 1 (default): light the "INS" icon on a channel when its track
;                  has at least one FX plugin.
; auto_indicator = 1 (default): light the "AUTO" indicator (red) when a track is
;                  armed for automation writing (Touch / Write / Latch mode).
; Set either to 0 to leave that icon alone.
;
; SCRIBBLE PEEKS - hold a button to momentarily overlay extra info on every
; channel's 4-character name strip; releasing it restores the track names. They
; reuse the ENCODER MODE > ENC ASSIGN 1/2 buttons (unused for encoder modes):
;
; peek_number = 1 (default): hold ENC ASSIGN 1 to show each track's REAPER track
;               NUMBER instead of its name.
; peek_db     = 1 (default): hold ENC ASSIGN 2 to show each fader's level in dB
;               (updates live while you move a fader).
; Set either to 0 to free that button / leave the strips alone.
;
; peek_latch  = 0 (default): ENC ASSIGN 1/2 are momentary (overlay only while held).
;               Set to 1 to make a PRESS toggle the overlay on, press again off -
;               for a permanent number/dB readout.
; touch_db    = 1 (default): while you touch/ride a fader, its strip shows that
;               fader's dB (live), restoring the track name on release. Set to 0
;               to leave the name up while you move faders.
;
; MASTER-SECTION READOUTS (recovered by sniffing Pro Tools, see DESIGN.md):
; select_assign = 1 (default): drive the SELECT ASSIGN label from the encoder mode
;                 (Pan / SndA-E). Rename the strings in the [labels] section below.
;                 Set 0 to leave that display field blank.
; cursor_mode   = 1 (default): drive the CURSOR MODE label (NAVIGATION / ZOOM) from
;                 the ENTER arrow-mode. Set 0 to leave it on the desk's own default.
; ===========================================================================

[display]

insert_icon    = 1
auto_indicator = 1
peek_number    = 1
peek_db        = 1
peek_latch     = 0
touch_db       = 1
select_assign  = 1
cursor_mode    = 1


; ===========================================================================
; [fx] - generic FX parameter editor (EFFECTS/PLUG-INS section)
;
; window_on_knob = 1 (default): moving a parameter knob floats that plug-in's
;                  window on screen (the PARAM button also toggles it open/closed).
;                  Set 0 if you don't want windows popping up as you turn knobs -
;                  the PARAM button still toggles the window on demand.
; ===========================================================================

[fx]

window_on_knob = 1


; ===========================================================================
; [labels] - custom text for the SELECT ASSIGN readout (4 characters max each)
;
; The SELECT ASSIGN field always reflects the *current encoder mode* (it can't be
; decoupled - a status field that lies is worse than none), but you can rename the
; words it shows. Useful if your sends always carry the same effects, e.g. send A =
; reverb -> show "Rvb" instead of "SndA". Longer text is truncated to 4 chars.
;
;   pan   -> shown in pan mode            (default "Pan")
;   aux1  -> shown when encoders ride send 1 / AUX A   (default "SndA")
;   aux2..aux5 -> sends 2-5 / AUX B-E                  (default "SndB".."SndE")
; ===========================================================================

[labels]

; pan  = Pan
; aux1 = SndA
; aux2 = SndB
; aux3 = SndC
; aux4 = SndD
; aux5 = SndE


; ===========================================================================
; [channel] - channel-strip button behaviour
;
; auto_button = what the per-channel AUTO key does (it has no native REAPER role):
;   automation (default) - cycle that track's REAPER automation mode
;                          (read -> touch -> latch -> write); the AUTO indicator
;                          lights in touch/write/latch so you can see the mode.
;   unity                - snap that channel's fader to 0 dB (handy "reset gain").
;   monitor              - cycle that track's record monitor (off -> on -> auto).
;
; double_touch = 1 (default): double-tap a motorized fader to snap it to 0 dB
;                (mirrors REAPER's double-click-fader-to-unity). Set 0 to disable.
; ===========================================================================

[channel]

auto_button  = automation
double_touch = 1


; ===========================================================================
; [encoder] - channel encoder (V-pot) modes via the ENCODER MODE / AUX SELECT row
;
; The channel encoders always do pan in ENC PAN mode. With sends enabled, the
; AUX SELECT buttons 1-5 switch the encoders to ride REAPER track SEND levels
; (send 1-5), exactly as the desk natively maps AUX A-E to encoder send level.
; The encoder ring shows the send level; turning an encoder is +/-1 dB per detent.
; Press ENC PAN to return the encoders (and rings) to pan.
;
; sends = 1 (default): AUX SELECT 1-5 -> encoder send-level mode.
; sends = 0: AUX SELECT does nothing on the surface; encoders stay on pan.
; ===========================================================================

[encoder]

sends = 1


; ===========================================================================
; [automix] - AUTOMIX section (button map hardware-verified 2026-06-17)
;
; The AUTOMIX section's two rows speak Pro Tools' automation model. Mapped to REAPER:
;
; TOP ROW = automation MODE. These are built in (no config): pressing one sets the
;   SELECTED tracks' automation mode (select all tracks to apply to all). The
;   per-channel AUTO indicator shows each track's mode by colour (green=Read,
;   orange=Touch/Latch, red=Write).
;     RELATIVE -> Trim    RETURN -> Read     ABORT/UNDO -> Touch
;     REC -> Write        AUTO-REC -> Latch  TOUCH SENSE -> Trim (Pro Tools "Off")
;
; ENABLE (Pro Tools SUSPEND) and the OVERWRITE row (which Pro Tools parameter TYPE
;   arms for recording) have no native REAPER equivalent, so they are free action
;   slots - assign any REAPER action ID (0 = nothing). The Pro Tools meaning of
;   each is noted; pick a REAPER action that fits your workflow.
;     suspend  = ENABLE button   (Pro Tools: suspend all automation)
;     ow_fader = OVERWRITE FADER (Pro Tools: arm Volume)
;     ow_on    = OVERWRITE ON    (Pro Tools: arm Mute)
;     ow_pan   = OVERWRITE PAN   (Pro Tools: arm Pan)
;     ow_aux   = OVERWRITE AUX   (Pro Tools: arm Send level)
;     ow_auxon = OVERWRITE AUX ON(Pro Tools: arm Send mute)
;     ow_eq    = OVERWRITE EQ    (Pro Tools: arm Plug-in)
;   (OVERWRITE SURROUND transmits no MIDI in the Pro Tools layer - it is inert.)
;
; Example: show the volume/pan envelopes for the OVERWRITE Fader/Pan buttons:
;   ow_fader = 40406   ; Track: Toggle track volume envelope visible
;   ow_pan   = 40407   ; Track: Toggle track pan envelope visible
; ===========================================================================

[automix]

suspend  = 0
ow_fader = 0
ow_on    = 0
ow_pan   = 0
ow_aux   = 0
ow_auxon = 0
ow_eq    = 0


; ===========================================================================
; [scene] - DM2000 scene recall via the GENERAL port (OPTIONAL, off by default)
;
; This links REAPER project markers to DM2000 scene memories, both ways. It is
; entirely optional and does nothing unless you (1) pick a GENERAL port in the
; control-surface settings dialog and (2) turn on send and/or receive below.
;
; THE GENERAL PORT
;   The 4 USB ports the plugin uses for HUI are the console's DAW (Pro Tools)
;   ports. Scene recall instead travels over the console's GENERAL Rx/Tx port,
;   which MUST be a different USB port - the DM2000 will not let a DAW port and
;   a GENERAL port share the same number. Set the GENERAL Rx/Tx port on the
;   console (DISPLAY ACCESS [MIDI] > "Setup"), then choose that same MIDI port
;   in the "GENERAL port" dropdown of the control-surface settings dialog. Leave
;   the dropdown on "None" to disable scene recall completely.
;
;   ALSO on DISPLAY ACCESS [MIDI] > MIDI Setup, set PROGRAM CHANGE Tx and Rx to ON.
;   Rx is on by default (lets the console RECEIVE a recall); Tx ships OFF, so the
;   console won't TRANSMIT a Program Change on recall until you turn it on - that
;   is what "receive" below needs. Scene N <-> Program Change #N (the console's
;   default Program Change Assign Table; if you remap that table, the mapping shifts).
;
; receive  (default 1 = on)
;   A scene RECALL on the console moves the REAPER edit cursor to the project
;   marker whose NUMBER matches the scene: scene N -> marker numbered N (the
;   console sends Program Change N-1; the scroll/display messages it also sends
;   are ignored). Matching is by number, not name, since marker names may repeat
;   - this is the same "go to marker N" jump the Locate Memory buttons perform,
;   just triggered by a console scene recall instead of a button press. Harmless
;   (it only moves the cursor) and inert unless a GENERAL port is set, so it is
;   on by default; set receive = 0 to disable.
;
; send  (default 0 = off)
;   REAPER drives the console's scene section from "#SCENE" markers over the GENERAL
;   port. Two behaviours, by transport state:
;     PLAYING  -> RECALL the scene as the play cursor crosses its marker (the desk
;                 physically reloads, in time with the music).
;     STOPPED  -> DISPLAY only: once the edit cursor settles (~0.3 s), the console's
;                 scene NUMBER scrolls to the scene owning the cursor - it never
;                 recalls while stopped, so editing never sweeps the faders.
;   Off by default because recall reloads the console (faders sweep); opt in with
;   send = 1. (Continuous scrubbing does not spam - it fires once after settling.)
;
; MARKER NAMING (send direction)
;   marker_prefix  (default "#SCENE")  tags a marker as a scene marker. The scene
;   number is the first word after the prefix; anything after it is a free label
;   for your own reference. If no number is given, the marker's own number is used.
;   Examples (case-insensitive; markers without the prefix are untouched):
;     "#SCENE 4 Chorus"  -> scene 4   (the "Chorus" label is ignored)
;     "#SCENE 12"        -> scene 12
;     "#SCENE Intro"     -> the scene matching this marker's own number
;
; Scenes 1-99 are supported (scene 0 is the console's read-only init scene).
; ===========================================================================

[scene]

send          = 0
receive       = 1
; marker_prefix = #SCENE
